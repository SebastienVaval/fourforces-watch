# Which city pack to load (file name in cities/ without .yaml)
CITY=miami
# Grok via the xAI API (https://console.x.ai). Without it: cameras stay "not checked", board uses templates.
XAI_API_KEY=
XAI_VISION_MODEL=grok-4.7
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning
XAI_IMAGE_DETAIL=high
# Optional keys - adapters skip gracefully when empty
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
FIRMS_MAP_KEY=
# Optional Mapbox basemap: a PUBLIC token (pk.*) from https://account.mapbox.com. Empty -> OpenStreetMap/CARTO tiles.
# Restrict it to your deploy URL in the Mapbox dashboard. Secret tokens (sk.*) are never sent to the browser.
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/dark-v11
# 1 = swap a few camera snapshots for openly licensed flood photos (clearly labelled SIMULATED)
DEMO_MODE=0
# Refresh period in seconds for every feed except PurpleAir
REFRESH_SECONDS=300
# PurpleAir bbox poll interval in seconds. Default 1800 (30 min). 0 = every app refresh.
# A free key starts with 1,000,000 points; the Miami bbox every 5 minutes spends them in a few days.
PURPLEAIR_REFRESH_SECONDS=1800
# Max camera snapshots classified per refresh (keeps API usage low)
MAX_CLASSIFY=12
# Contact sent in the User-Agent to api.weather.gov (NWS asks for one)
CONTACT=fourforces-watch@example.org
# Optional: extra importable adapter packages, comma separated
ADAPTER_PACKAGES=
