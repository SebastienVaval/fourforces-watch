# Which city pack to load (file name in cities/ without .yaml)
CITY=miami
# Grok via the xAI API (https://console.x.ai). Without it: cameras stay "not checked", board uses templates.
XAI_API_KEY=
XAI_VISION_MODEL=grok-4.7
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning
XAI_IMAGE_DETAIL=high
# Optional keys - adapters skip gracefully when empty
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
FIRMS_MAP_KEY=
# 1 = swap a few camera snapshots for openly licensed flood photos (clearly labelled SIMULATED)
DEMO_MODE=0
# Refresh period in seconds
REFRESH_SECONDS=300
# Max camera snapshots classified per refresh (keeps API usage low)
MAX_CLASSIFY=12
# Contact sent in the User-Agent to api.weather.gov (NWS asks for one)
CONTACT=fourforces-watch@example.org
# Optional: extra importable adapter packages, comma separated
ADAPTER_PACKAGES=
